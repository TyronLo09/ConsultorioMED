@model ConsultorioMedAPP.Models.EstadoCitum

@{
    ViewData["Title"] = "Eliminar Estado de Cita";
}

<div class="container mt-4">
    <h2 class="text-center text-danger mb-4">Eliminar Estado de Cita</h2>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-warning text-center shadow-sm">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                <p class="mt-2 mb-0">¿Estás seguro que deseas eliminar este estado de cita?</p>
            </div>

            <div class="card shadow-sm p-4 mb-4 bg-light">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripcion)</dd>

                    <dt class="col-sm-4">Activo</dt>
                    <dd class="col-sm-8">
                        @(Model.Activo == true ? "Sí" : "No")
                    </dd>
                </dl>
            </div>

            <form asp-action="Delete" class="d-flex justify-content-between mt-3">
                <input type="hidden" asp-for="IdEstadoCita" />
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
