@model ConsultorioMedAPP.Models.EstadoCitum

@{
    ViewData["Title"] = "Detalles del Estado de Cita";
}

<div class="container mt-4">
    <h2 class="text-center text-primary mb-4">
        <i class="bi bi-info-circle"></i> Detalles del Estado de Cita
    </h2>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm p-4 bg-light">
                <dl class="row mb-0">
                    <dt class="col-sm-4 fw-bold">Descripción</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripcion)</dd>

                    <dt class="col-sm-4 fw-bold">Activo</dt>
                    <dd class="col-sm-8">
                        @(Model.Activo == true ? "Sí" : "No")
                    </dd>
                </dl>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al listado
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.IdEstadoCita" class="btn btn-primary">
                    <i class="bi bi-pencil-square"></i> Editar
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
