@model ConsultorioMedAPP.Models.EstadoCitum

@{
    ViewData["Title"] = "Registrar Estado de Cita";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Registrar Nuevo Estado de Cita</h2>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Create" class="shadow p-4 rounded bg-light">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Descripcion" class="form-label">Descripción del Estado</label>
                    <input asp-for="Descripcion" class="form-control" placeholder="Ej: Pendiente, Completada, Cancelada" />
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Volver a la lista
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar Estado
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
