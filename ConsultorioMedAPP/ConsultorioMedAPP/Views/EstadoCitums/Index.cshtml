@model IEnumerable<ConsultorioMedAPP.Models.EstadoCitum>

@{
    ViewData["Title"] = "Estados de Cita";
}

<style>
    /* 🔹 Estilos generales para todos los botones redondos */
    .btn-rounded {
        border-radius: 50px;
        padding: 6px 16px;
        font-weight: 500;
        transition: all 0.2s ease-in-out;
    }

        .btn-rounded i {
            margin-right: 6px;
        }

    /* 🟦 Botón Editar - azul */
    .btn-editar {
        background-color: #0d6efd;
        color: white !important;
        border: none;
    }

        .btn-editar:hover {
            background-color: #0b5ed7;
            transform: scale(1.05);
        }

    /* 🟩 Botón Detalles - turquesa */
    .btn-detalles {
        background-color: #20c997;
        color: white !important;
        border: none;
    }

        .btn-detalles:hover {
            background-color: #17a589;
            transform: scale(1.05);
        }

    /* 🔴 Botón Eliminar - rojo */
    .btn-eliminar {
        background-color: #dc3545;
        color: white !important;
        border: none;
    }

        .btn-eliminar:hover {
            background-color: #bb2d3b;
            transform: scale(1.05);
        }

    /* 🟢 Botón Nuevo Estado */
    .btn-nuevo {
        border-radius: 50px;
        padding: 8px 18px;
        font-weight: 500;
        background-color: #198754;
        color: white !important;
        border: none;
    }

        .btn-nuevo:hover {
            background-color: #157347;
            transform: scale(1.05);
        }

    /* Espaciado entre botones */
    .btn-group .btn-rounded {
        margin: 0 4px;
    }
</style>

<div class="container mt-4">
    <h2 class="text-center text-primary mb-4">
        <i class="bi bi-list-ul"></i> Lista de Estados de Cita
    </h2>
    <hr />

    <div class="d-flex justify-content-end mb-3">
        <a asp-action="Create" class="btn btn-nuevo">
            <i class="bi bi-plus-circle"></i> Nuevo Estado
        </a>
    </div>

    <div class="card shadow-sm p-3 bg-light">
        <table class="table table-hover align-middle text-center">
            <thead class="table-primary">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                    <th>@Html.DisplayNameFor(model => model.Activo)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                        <td>
                            @if (item.Activo == true)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.IdEstadoCita" class="btn-rounded btn-editar btn-sm">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <a asp-action="Details" asp-route-id="@item.IdEstadoCita" class="btn-rounded btn-detalles btn-sm">
                                    <i class="bi bi-eye-fill"></i> Detalles
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.IdEstadoCita" class="btn-rounded btn-eliminar btn-sm">
                                    <i class="bi bi-trash-fill"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
