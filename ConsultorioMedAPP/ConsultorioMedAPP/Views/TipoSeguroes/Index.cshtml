@model IEnumerable<ConsultorioMedAPP.Models.TipoSeguro>

@{
    ViewData["Title"] = "Listado de Tipos de Seguro";
}

<h1>Tipos de Seguro</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo</a>
</p>

<table class="table table-hover table-bordered table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
            <th>@Html.DisplayNameFor(model => model.Porcentaje)</th>
            <th>@Html.DisplayNameFor(model => model.Activo)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)

        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                <td>@Html.DisplayFor(modelItem => item.Porcentaje)</td>

                <td>
                    @((item.Activo ?? false) ? "Sí" : "No")
                </td>

                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.IdTipoSeguro" class="btn btn-sm btn-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.IdTipoSeguro" class="btn btn-sm btn-info">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.IdTipoSeguro" class="btn btn-sm btn-danger">Eliminar</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>