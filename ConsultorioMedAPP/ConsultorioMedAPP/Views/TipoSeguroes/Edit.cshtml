@model ConsultorioMedAPP.Models.TipoSeguro

@{
    ViewData["Title"] = "Editar Tipo de Seguro";
}

<h1>Editar</h1>

<h4>Tipo de Seguro</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdTipoSeguro" />

            <div class="form-group mb-3">
                <label asp-for="Descripcion" class="control-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Porcentaje" class="control-label"></label>
                <input asp-for="Porcentaje" class="form-control" />
                <span asp-validation-for="Porcentaje" class="text-danger"></span>
            </div>


            <div class="form-group form-check form-switch mb-3">

                <input class="form-check-input" type="checkbox" role="switch" name="Activo" value="true" checked="@(Model.Activo ?? false)" />
                <label class="form-check-label" asp-for="Activo">
                    @Html.DisplayNameFor(model => model.Activo)
                </label>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}