@model ConsultorioMedAPP.Models.TipoTurno

@{
    ViewData["Title"] = "Eliminar Tipo de Turno";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-danger text-white text-center py-3">
            <h3 class="mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar eliminación
            </h3>
        </div>

        <div class="card-body">
            <p class="text-center fs-5 mb-4">
                ¿Estás seguro de que deseas eliminar este tipo de turno? <br />
                <strong class="text-danger">Esta acción no se puede deshacer.</strong>
            </p>

            <div class="border rounded-4 p-4 bg-light shadow-sm">
                <dl class="row g-3 mb-0">
                    <dt class="col-sm-3 fw-bold text-secondary">Descripción:</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>

                    <dt class="col-sm-3 fw-bold text-secondary">Hora de Entrada:</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.HoraEntrada)</dd>

                    <dt class="col-sm-3 fw-bold text-secondary">Hora de Salida:</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.HoraSalida)</dd>
                </dl>
            </div>
        </div>

        <div class="card-footer text-center">
            <form asp-action="Delete" class="d-inline">
                <input type="hidden" asp-for="IdTipoTurno" />
                <button type="submit" class="btn btn-danger px-4 me-2">
                    <i class="bi bi-trash"></i> Eliminar definitivamente
                </button>
            </form>
            <a asp-action="Index" class="btn btn-secondary px-4">
                <i class="bi bi-arrow-left-circle"></i> Cancelar
            </a>
        </div>
    </div>
</div>

