@model IEnumerable<ConsultorioMedAPP.Models.TipoTurno>

@{
    ViewData["Title"] = "Tipos de Turno";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Tipos de Turno</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nuevo
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                    <th>@Html.DisplayNameFor(model => model.HoraEntrada)</th>
                    <th>@Html.DisplayNameFor(model => model.HoraSalida)</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                        <td>@Html.DisplayFor(modelItem => item.HoraEntrada)</td>
                        <td>@Html.DisplayFor(modelItem => item.HoraSalida)</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.IdTipoTurno" class="btn btn-sm btn-warning me-1">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@item.IdTipoTurno" class="btn btn-sm btn-info me-1">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdTipoTurno" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
