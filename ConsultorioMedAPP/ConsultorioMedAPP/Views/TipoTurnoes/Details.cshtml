@model ConsultorioMedAPP.Models.TipoTurno

@{
    ViewData["Title"] = "Detalles del Tipo de Turno";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-info text-white text-center py-3">
            <h3 class="mb-0">
                <i class="bi bi-info-circle-fill me-2"></i> Detalles del Tipo de Turno
            </h3>
        </div>

        <div class="card-body">
            <dl class="row g-3 mb-0">
                <dt class="col-sm-3 fw-bold text-secondary">Descripción:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>

                <dt class="col-sm-3 fw-bold text-secondary">Hora de Entrada:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.HoraEntrada)</dd>

                <dt class="col-sm-3 fw-bold text-secondary">Hora de Salida:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.HoraSalida)</dd>
            </dl>
        </div>

        <div class="card-footer text-center">
            <a asp-action="Edit" asp-route-id="@Model?.IdTipoTurno" class="btn btn-primary px-4 me-2">
                <i class="bi bi-pencil-square"></i> Editar
            </a>
            <a asp-action="Index" class="btn btn-secondary px-4">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>
        </div>
    </div>
</div>
