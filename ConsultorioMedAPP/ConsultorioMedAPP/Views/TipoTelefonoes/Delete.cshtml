@model ConsultorioMedAPP.Models.TipoTelefono

@{
    ViewData["Title"] = "Eliminar Tipo de Teléfono";
}

<h1 class="text-danger mb-4">Eliminar Tipo de Teléfono</h1>

<div class="card shadow-sm p-4">
    <h5>¿Está seguro que desea eliminar este registro?</h5>
    <hr />

    <dl class="row">
        <dt class="col-sm-3 fw-bold">Descripción</dt>
        <dd class="col-sm-9">@Model.Descripcion</dd>

        <dt class="col-sm-3 fw-bold">Estado</dt>
        <dd class="col-sm-9">
            @(Model.Activo == true
                ? "Activo"
                : "Inactivo")
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdTipoTelefono" />
        <button type="submit" class="btn btn-danger px-4">
            <i class="bi bi-trash"></i> Eliminar
        </button>
        <a asp-action="Index" class="btn btn-secondary px-4 ms-2">
            <i class="bi bi-arrow-left"></i> Cancelar
        </a>
    </form>
</div>

