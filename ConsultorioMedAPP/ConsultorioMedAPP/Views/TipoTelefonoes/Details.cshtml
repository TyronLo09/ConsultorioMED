@model ConsultorioMedAPP.Models.TipoTelefono

@{
    ViewData["Title"] = "Detalles del Tipo de Teléfono";
}

<h1 class="text-info mb-4">Detalles del Tipo de Teléfono</h1>

<div class="card shadow-sm p-4">
    <dl class="row">
        <dt class="col-sm-3 fw-bold">Descripción</dt>
        <dd class="col-sm-9">@Model.Descripcion</dd>

        <dt class="col-sm-3 fw-bold">Estado</dt>
        <dd class="col-sm-9">
            @(Model.Activo == true
                ? "Activo"
                : "Inactivo")
        </dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model?.IdTipoTelefono" class="btn btn-primary px-4 me-2">
            <i class="bi bi-pencil"></i> Editar
        </a>
        <a asp-action="Index" class="btn btn-secondary px-4">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>
