@model IEnumerable<ConsultorioMedAPP.Models.TipoTelefono>

@{
    ViewData["Title"] = "Tipos de Teléfono";
}

<h1 class="mb-4 text-info">Tipos de Teléfono</h1>

<p>
    <a asp-action="Create" class="btn btn-success px-4 mb-3">
        <i class="bi bi-plus-circle"></i> Crear nuevo
    </a>
</p>

<table class="table table-hover table-bordered align-middle shadow-sm">
    <thead class="table-primary text-center">
        <tr>
            <th>Descripción</th>
            <th>Estado</th>
            <th style="width: 220px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Descripcion</td>
                <td class="text-center">
                    @if (item.Activo == true)
                    {
                        <span class="badge bg-success px-3 py-2">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-2">Inactivo</span>
                    }
                </td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.IdTipoTelefono" class="btn btn-primary btn-sm px-3 me-1">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.IdTipoTelefono" class="btn btn-info btn-sm px-3 me-1 text-white">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.IdTipoTelefono" class="btn btn-danger btn-sm px-3">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
