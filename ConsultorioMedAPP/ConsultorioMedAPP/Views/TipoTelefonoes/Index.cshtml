@model IEnumerable<ConsultorioMedAPP.Models.TipoTelefono>

@{
    ViewData["Title"] = "Tipos de Teléfono";
}

<h1 class="text-center mb-4">Lista de Tipos de Teléfono</h1>

<p>
    <a asp-action="Create" class="btn btn-success shadow-sm">
        <i class="bi bi-plus-circle"></i> Crear Nuevo Tipo de Teléfono
    </a>
</p>

<table class="table table-striped table-bordered shadow-sm align-middle rounded">
    <thead class="table-success text-center">
        <tr>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody class="text-center">
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Descripcion</td>

                <td>
                    @if (item.Activo == true)
                    {
                        <span class="badge bg-success px-3 py-2">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-2">Inactivo</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdTipoTelefono" class="btn btn-primary btn-sm me-1">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdTipoTelefono" class="btn btn-info btn-sm me-1 text-white">
                        <i class="bi bi-eye"></i> Detalles
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdTipoTelefono" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
