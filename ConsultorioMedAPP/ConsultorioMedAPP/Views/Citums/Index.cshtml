@model IEnumerable<ConsultorioMedAPP.Models.Citum>

@{
    ViewData["Title"] = "Listado de Citas";
}

<style>
    /* 🔹 Estilos de botones y tabla para uniformar con otros módulos */
    .btn-rounded {
        border-radius: 50px;
        padding: 6px 16px;
        font-weight: 500;
        transition: all 0.2s ease-in-out;
    }

        .btn-rounded i {
            margin-right: 6px;
        }

    .btn-editar {
        background-color: #0d6efd;
        color: white !important;
        border: none;
    }

        .btn-editar:hover {
            background-color: #0b5ed7;
            transform: scale(1.05);
        }

    .btn-detalles {
        background-color: #20c997;
        color: white !important;
        border: none;
    }

        .btn-detalles:hover {
            background-color: #17a589;
            transform: scale(1.05);
        }

    .btn-eliminar {
        background-color: #dc3545;
        color: white !important;
        border: none;
    }

        .btn-eliminar:hover {
            background-color: #bb2d3b;
            transform: scale(1.05);
        }

    .btn-group .btn-rounded {
        margin: 0 4px;
    }
</style>


<div class="container mt-4">

    <!-- ENCABEZADO + BOTONES -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-calendar3"></i> Listado de Citas</h2>

        <div class="d-flex gap-2">
            <!-- Crear Nuevo -->
            <a asp-action="Create" class="btn btn-success rounded-3 shadow-sm">
                <i class="bi bi-plus-circle"></i> Nueva Cita
            </a>

            <!-- Exportar Excel -->
            <a asp-action="ExportExcel" class="btn btn-outline-success rounded-3 shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet"></i> Excel
            </a>

            <!-- Exportar PDF -->
            <a asp-action="ExportPDF" class="btn btn-outline-danger rounded-3 shadow-sm">
                <i class="bi bi-filetype-pdf"></i> PDF
            </a>
        </div>
    </div>

    <table class="table table-striped table-hover shadow-sm align-middle">
        <thead class="table-primary text-center">
            <tr>
                <th>ID</th>
                <th>Paciente</th>
                <th>Doctor</th>
                <th>Estado</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Precio (₡)</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr class="text-center">
                    <td>@item.IdCita</td>

                    <!-- Paciente -->
                    <td>
                        @(item.PacienteIdCedulaNavigation?.IdCedulaNavigation != null ?
                            $"{item.PacienteIdCedulaNavigation.IdCedulaNavigation.Nombre} " +
                            $"{item.PacienteIdCedulaNavigation.IdCedulaNavigation.Apellido1} " +
                            $"{item.PacienteIdCedulaNavigation.IdCedulaNavigation.Apellido2}" :
                            "Sin asignar")
                    </td>

                    <!-- Doctor -->
                    <td>
                        @(item.DoctorIdCedulaNavigation?.IdCedulaNavigation != null ?
                            $"{item.DoctorIdCedulaNavigation.IdCedulaNavigation.Nombre} " +
                            $"{item.DoctorIdCedulaNavigation.IdCedulaNavigation.Apellido1} " +
                            $"{item.DoctorIdCedulaNavigation.IdCedulaNavigation.Apellido2}" :
                            "Sin asignar")
                    </td>

                    <!-- Estado -->
                    <td>@item.EstadoCitaIdEstadoCitaNavigation?.Descripcion</td>

                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@item.Hora</td>
                    <td>@item.Precio.ToString("N2")</td>

                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@item.IdCita" class="btn-rounded btn-editar btn-sm">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@item.IdCita" class="btn-rounded btn-detalles btn-sm">
                                <i class="bi bi-eye-fill"></i> Detalles
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdCita" class="btn-rounded btn-eliminar btn-sm">
                                <i class="bi bi-trash-fill"></i> Eliminar
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>


    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center mt-4">
            <i class="bi bi-exclamation-circle"></i> No hay citas registradas actualmente.
        </div>
    }

</div>
