@model ConsultorioMedAPP.Models.Citum

@{
    ViewData["Title"] = "Eliminar Cita";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-3 border-0">
                <div class="card-header bg-danger text-white text-center">
                    <h4><i class="bi bi-exclamation-triangle-fill"></i> Confirmar Eliminación</h4>
                </div>
                <div class="card-body bg-light">
                    <p class="text-center fs-5 mb-4">
                        ¿Está seguro de que desea eliminar esta cita?
                    </p>
                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Fecha</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Fecha)</dd>

                        <dt class="col-sm-4">Hora</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Hora)</dd>

                        <dt class="col-sm-4">Precio (₡)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Precio)</dd>

                        <dt class="col-sm-4">Fecha de Creación</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaCreacion)</dd>

                        <dt class="col-sm-4">Última Actualización</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaActualizacion)</dd>

                        <dt class="col-sm-4">Doctor</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.DoctorIdCedulaNavigation.IdCedula)</dd>

                        <dt class="col-sm-4">Estado de la Cita</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.EstadoCitaIdEstadoCitaNavigation.IdEstadoCita)</dd>

                        <dt class="col-sm-4">Paciente</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.PacienteIdCedulaNavigation.IdCedula)</dd>
                    </dl>

                    <form asp-action="Delete" class="mt-4 text-center">
                        <input type="hidden" asp-for="IdCita" />
                        <button type="submit" class="btn btn-danger px-4 me-3">
                            <i class="bi bi-trash-fill"></i> Eliminar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left"></i> Volver a la lista
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
