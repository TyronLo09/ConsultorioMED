@model ConsultorioMedAPP.Models.Citum

@{
    ViewData["Title"] = "Registrar Cita";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Registrar Nueva Cita</h2>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Create" class="shadow p-4 rounded bg-light">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- PACIENTE -->
                <div class="form-group mb-3">
                    <label asp-for="PacienteIdCedula" class="form-label">Paciente</label>
                    <select asp-for="PacienteIdCedula" class="form-select" asp-items="ViewBag.PacienteIdCedula">
                        <option value="">-- Seleccione un Paciente --</option>
                    </select>
                    <span asp-validation-for="PacienteIdCedula" class="text-danger"></span>
                </div>

                <!-- DOCTOR -->
                <div class="form-group mb-3">
                    <label asp-for="DoctorIdCedula" class="form-label">Doctor</label>
                    <select asp-for="DoctorIdCedula" class="form-select" asp-items="ViewBag.DoctorIdCedula">
                        <option value="">-- Seleccione un Doctor --</option>
                    </select>
                    <span asp-validation-for="DoctorIdCedula" class="text-danger"></span>
                </div>

                <!-- FECHA -->
                <div class="form-group mb-3">
                    <label asp-for="Fecha" class="form-label">Fecha de la Cita</label>
                    <input asp-for="Fecha" class="form-control" type="date" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>

                <!-- HORA -->
                <div class="form-group mb-3">
                    <label asp-for="Hora" class="form-label">Hora</label>
                    <input asp-for="Hora" class="form-control" type="time" />
                    <span asp-validation-for="Hora" class="text-danger"></span>
                </div>

                <!-- ESTADO -->
                <div class="form-group mb-3">
                    <label asp-for="EstadoCitaIdEstadoCita" class="form-label">Estado de la Cita</label>
                    <select asp-for="EstadoCitaIdEstadoCita" class="form-select" asp-items="ViewBag.EstadoCitaIdEstadoCita">
                        <option value="">-- Seleccione un Estado --</option>
                    </select>
                    <span asp-validation-for="EstadoCitaIdEstadoCita" class="text-danger"></span>
                </div>

                <!-- PRECIO -->
                <div class="form-group mb-3">
                    <label asp-for="Precio" class="form-label">Precio (₡)</label>
                    <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>

                <!-- BOTONES -->
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Volver a la lista
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar Cita
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
