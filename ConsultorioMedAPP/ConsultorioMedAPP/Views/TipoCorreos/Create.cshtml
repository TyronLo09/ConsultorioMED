@model ConsultorioMedAPP.Models.TipoCorreo

@{
    ViewData["Title"] = "Crear Tipo de Correo";
}

<h1 class="mb-4 text-success">Crear Tipo de Correo</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Descripcion" class="form-label fw-bold"></label>
                <input asp-for="Descripcion" class="form-control" placeholder="Ingrese la descripción del tipo de correo" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Crear" class="btn btn-success px-4" />
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
