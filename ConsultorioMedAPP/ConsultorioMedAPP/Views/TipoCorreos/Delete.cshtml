@model ConsultorioMedAPP.Models.TipoCorreo

@{
    ViewData["Title"] = "Eliminar Tipo de Correo";
}

<h1 class="text-danger mb-4">Eliminar Tipo de Correo</h1>

<h4>¿Está seguro que desea eliminar este registro?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3 fw-bold">Descripción</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>

    <dt class="col-sm-3 fw-bold">Estado</dt>
    <dd class="col-sm-9">
        @if (Model.Activo == true)
        {
            <span class="badge bg-success px-3 py-2">Activo</span>
        }
        else
        {
            <span class="badge bg-danger px-3 py-2">Inactivo</span>
        }
    </dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdTipoCorreo" />

    <div class="d-flex gap-2 mt-3">
        <input type="submit" value="Eliminar" class="btn btn-danger px-4" />
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </div>
</form>
</div>
