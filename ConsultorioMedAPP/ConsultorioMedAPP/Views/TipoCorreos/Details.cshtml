@model ConsultorioMedAPP.Models.TipoCorreo

@{
    ViewData["Title"] = "Detalles del Tipo de Correo";
}

<h1 class="mb-4 text-info">Detalles del Tipo de Correo</h1>

<div class="card shadow-sm p-4 border-0">
    <h4 class="fw-bold mb-3">Información del Tipo de Correo</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3 fw-bold">Descripción</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>

        <dt class="col-sm-3 fw-bold">Estado</dt>
        <dd class="col-sm-9">
            @if (Model.Activo == true)
            {
                <span class="badge bg-success px-3 py-2">Activo</span>
            }
            else
            {
                <span class="badge bg-danger px-3 py-2">Inactivo</span>
            }
        </dd>
    </dl>

    <div class="d-flex gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model?.IdTipoCorreo" class="btn btn-primary px-4">Editar</a>
        <a asp-action="Index" class="btn btn-secondary px-4">Volver a la lista</a>
    </div>
</div>

