@{
    ViewData["Title"] = "Lista de Pacientes";
    var busquedaSel = ViewData["BusquedaSel"] as string;
}

<h1 class="text-center">Lista de Pacientes</h1>

@* MENSAJES DE ÉXITO Y ERROR *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>¡Éxito!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>¡Error!</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-success">Crear Nuevo Paciente</a>
</p>

@* FORMULARIO DE BÚSQUEDA Y BOTONES DE EXPORTACIÓN *@
<form method="get" asp-action="Index" class="row g-3 mb-4 align-items-end">

    @* Campo de búsqueda (5 columnas) *@
    <div class="col-md-5">
        <label for="busqueda" class="form-label">Buscar Paciente (Cédula o Nombre)</label>
        <input type="text" id="busqueda" name="busqueda" class="form-control"
               value="@busquedaSel" placeholder="Ingrese Cédula o Nombre" />
    </div>

    @* Botón Buscar (2 columnas) *@
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Buscar</button>
    </div>

    @* Botón Restablecer (2 columnas) *@
    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-secondary w-100">Restablecer</a>
    </div>

    @* --- AQUÍ AGREGUÉ LOS BOTONES DE EXPORTAR (3 columnas restantes) --- *@
    <div class="col-md-3">
        <label class="form-label d-block">&nbsp;</label> @* Label vacío para alinear visualmente *@
        <div class="btn-group w-100" role="group">
            <a asp-action="ExportarExcel" asp-route-busqueda="@busquedaSel" class="btn btn-success" title="Descargar Excel">
                Excel
            </a>
            <a asp-action="ExportarPdf" asp-route-busqueda="@busquedaSel" class="btn btn-danger" title="Descargar PDF">
                PDF
            </a>
        </div>
    </div>

</form>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Cédula</th>
                <th>Nombre Completo</th>
                <th>Tipo de Seguro</th>
                <th>Porcentaje (%)</th>
                <th>Enfermedad (Tipo)</th>
                <th>¿Es Crónico?</th>
                <th>Descripción Antecedentes</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.Pacientes != null)
            {
                @foreach (var item in (dynamic)ViewBag.Pacientes)
                {
                    <tr>
                        <td>@item.Cedula</td>
                        <td>@item.Nombre @item.Apellido1 @item.Apellido2</td>
                        <td>@item.TipoSeguro</td>
                        <td>@item.PorcentajeSeguro</td>
                        <td>@item.TipoEnfermedadDescripcion</td>
                        <td>@item.EsCronico</td>
                        <td>
                            <div style="max-height: 50px; overflow-y: auto; border: 1px solid #ccc; padding: 5px;">
                                @item.AntecedentesDescripcion
                            </div>
                        </td>
                        <td>
                            <span class="badge @(item.Estado ? "badge-success" : "badge-danger") text-black" style="color: black !important;">
                                @(item.Estado ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Cedula" class="btn btn-primary btn-sm">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Cedula" class="btn btn-info btn-sm">Detalles</a>
                                <a asp-action="Delete" asp-route-id="@item.Cedula" class="btn btn-danger btn-sm">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">No hay pacientes registrados o la conexión a la base de datos falló.</td>
                </tr>
            }
        </tbody>
    </table>
</div>