@model ConsultorioMedAPP.Models.Paciente

@{
    ViewData["Title"] = "Registrar Nuevo Paciente";
}

<h2 class="text-center mb-4">Registrar Nuevo Paciente</h2>

@* MENSAJES DE ÉXITO Y ERROR *@
@if (TempData["Success"] != null)
{
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>¡Éxito!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
}
@if (TempData["Error"] != null)
{
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>¡Error!</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
}

<div class="container mt-4">
    <form asp-action="Create" method="post">

        <h4 class="mt-4">Datos del Paciente</h4>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <label class="form-label">Cédula del Paciente (Persona Existente)</label>
                <select name="IdCedula" id="IdCedula" class="form-select" asp-items="ViewBag.IdCedula" required>
                    <option value="">-- Seleccione Cédula --</option>
                </select>
                <small class="form-text text-muted">
                    Solo aparecen personas que NO son Doctores ni Usuarios
                </small>
            </div>
        </div>

        <div id="PersonaData" class="alert alert-info mt-3" style="display: none;">
            <strong>Persona Seleccionada:</strong> <span id="PersonaNombre"></span>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <label asp-for="Estado" class="form-label">Estado del Paciente</label>
                <select asp-for="Estado" class="form-select" name="Estado">
                    <option value="true" selected>Activo</option>
                    <option value="false">Inactivo</option>
                </select>
            </div>
        </div>

        <h4 class="mt-4">Información del Seguro</h4>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <label class="form-label">Tipo de Seguro</label>
                <select name="IdTipoSeguro" class="form-select" asp-items="ViewBag.IdTipoSeguro" required>
                    <option value="">-- Seleccione Tipo de Seguro --</option>
                </select>
            </div>
        </div>

        <h4 class="mt-4">Antecedentes Médicos</h4>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <label class="form-label">Tipo de Enfermedad</label>
                <select name="IdTipoEnfermedad" class="form-select" asp-items="ViewBag.IdTipoEnfermedad" required>
                    <option value="">-- Seleccione Tipo de Enfermedad --</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">¿Es Crónica?</label>
                <select name="Cronico" class="form-select" required>
                    <option value="true">Sí</option>
                    <option value="false">No</option>
                </select>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <label class="form-label">Descripción de Antecedentes</label>
                <textarea name="DescripcionAntecedente" id="DescripcionAntecedente" class="form-control" rows="3" placeholder="Escriba aquí los antecedentes médicos del paciente..."></textarea>
            </div>
        </div>

        <div class="mt-4">
            <input type="submit" value="Crear Paciente" class="btn btn-success" />
            <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

        <script>
            document.getElementById('IdCedula').addEventListener('change', function() {
                var cedula = this.value;
                var personaDataDiv = document.getElementById('PersonaData');
                var personaNombreSpan = document.getElementById('PersonaNombre');
                var descripcionTextarea = document.getElementById('DescripcionAntecedente');

                // Limpiar si no hay cédula seleccionada
                if (!cedula) {
                    personaDataDiv.style.display = 'none';
                    personaNombreSpan.innerHTML = '';
                    descripcionTextarea.value = '';
                    return;
                }

                // Llama al método AJAX para obtener datos de la persona
                fetch('@Url.Action("GetPersonaData", "Pacientes")?idCedula=' + cedula)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Cédula no encontrada o error de servidor: ' + response.status);
                        }
                        return response.json();
                    })
                    .then(data => {
                        // Mostrar nombre completo y fecha de nacimiento
                        var nombreCompleto = `${data.nombre} ${data.apellido1} ${data.apellido2}`;
                        personaNombreSpan.innerHTML = `${nombreCompleto} (Nacimiento: ${data.fechaNacimiento})`;
                        personaDataDiv.style.display = 'block';

                        // Limpiar el textarea para que el usuario escriba
                        descripcionTextarea.value = '';
                        descripcionTextarea.focus();
                    })
                    .catch(error => {
                        console.error('Error al obtener datos de la persona:', error);
                        personaNombreSpan.innerHTML = '<span class="text-danger">Error al cargar datos.</span>';
                        personaDataDiv.style.display = 'block';
                    });
            });
        </script>
}