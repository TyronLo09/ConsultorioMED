@model ConsultorioMedAPP.Models.Persona

@{
    ViewData["Title"] = "Editar persona";
}

<h2 class="text-center mb-4">Editar persona</h2>

<div class="container mt-4">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="IdCedula" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-md-4">
                <label asp-for="IdCedula" class="form-label">Cédula</label>
                <input asp-for="IdCedula" class="form-control" readonly />
            </div>
            <div class="col-md-4">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label asp-for="Apellido1" class="form-label">Primer Apellido</label>
                <input asp-for="Apellido1" class="form-control" required />
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-4">
                <label asp-for="Apellido2" class="form-label">Segundo Apellido</label>
                <input asp-for="Apellido2" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="FechaNacimiento" class="form-label">Fecha de nacimiento</label>
                <input asp-for="FechaNacimiento" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label asp-for="IdGenero" class="form-label">Género</label>
                <select asp-for="IdGenero" class="form-select" asp-items="ViewBag.IdGenero"></select>
            </div>
        </div>

        <hr class="my-4" />

        <!-- BLOQUE DE CORREO CORREGIDO -->
        <div class="row">
            <div class="col-md-6">
                <label class="form-label">Tipo de correo</label>
                <select name="TipoCorreo" class="form-select">
                    <option value="">-- Seleccione --</option>
                    @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.IdTipoCorreo)
                    {
                        if (item.Value == (ViewBag.PrimerTipoCorreo?.ToString() ?? ""))
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Correo electrónico</label>
                <input name="DirecCorreo" type="email" class="form-control" value="@ViewBag.PrimerCorreo" />
            </div>
        </div>

        <!-- BLOQUE DE TELÉFONO CORREGIDO -->
        <div class="row mt-3">
            <div class="col-md-6">
                <label class="form-label">Tipo de teléfono</label>
                <select name="TipoTelefono" class="form-select">
                    <option value="">-- Seleccione --</option>
                    @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.IdTipoTelefono)
                    {
                        if (item.Value == (ViewBag.PrimerTipoTelefono?.ToString() ?? ""))
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Número de teléfono</label>
                <input name="Telefono" type="tel" class="form-control" value="@ViewBag.PrimerTelefono" pattern="\d{8,15}" />
            </div>
        </div>


        <!-- 🔧 CHECKBOX ACTIVO -->
        <div class="row mt-3">
            <div class="col-md-3">
                <div class="form-check form-switch">
                    <input type="checkbox"
                           class="form-check-input"
                           id="Activo"
                           name="Activo"
                           value="true"
                    @(Model.Activo == true ? "checked" : "") />
                    <label class="form-check-label" for="Activo">Activo</label>
                </div>

            </div>
        </div>

        <div class="mt-4">
            <input type="submit" value="Guardar cambios" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
