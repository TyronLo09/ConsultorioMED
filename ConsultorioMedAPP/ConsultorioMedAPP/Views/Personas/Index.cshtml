@model IEnumerable<ConsultorioMedAPP.Models.Persona>

@{
    ViewData["Title"] = "Lista de Personas";

    // ✅ Variables locales para evitar errores de Razor
    var generoSel = (ViewBag.GeneroSeleccionado as string) ?? "";
    var cantidadSel = ViewBag.CantidadSeleccionada != null ? ViewBag.CantidadSeleccionada.ToString() : "";
}

<h1 class="text-center mb-4">Lista de Personas</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Crear Nueva Persona</a>
</p>

<!-- FORMULARIO DE FILTRO -->
<form method="get" asp-action="Index" class="row g-3 mb-3 align-items-end">
    <div class="col-md-3">
        <label for="cantidad" class="form-label">Cantidad a mostrar</label>
        <input type="number" id="cantidad" name="cantidad" class="form-control" min="1"
               value="@cantidadSel" placeholder="Ej: 5" />
    </div>

    <div class="col-md-3">
        <label for="genero" class="form-label">Filtrar por género</label>
        <select id="genero" name="genero" class="form-select">
            @if (string.IsNullOrEmpty(generoSel))
            {
                <option value="" selected="selected">Todos</option>
            }
            else
            {
                <option value="">Todos</option>
            }

            @if (generoSel == "Hombre")
            {
                <option value="Hombre" selected="selected">Hombre</option>
            }
            else
            {
                <option value="Hombre">Hombre</option>
            }

            @if (generoSel == "Mujer")
            {
                <option value="Mujer" selected="selected">Mujer</option>
            }
            else
            {
                <option value="Mujer">Mujer</option>
            }
        </select>
    </div>


    <div class="col-md-2">
        <button type="submit" class="btn btn-success w-100">Filtrar</button>
    </div>

    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-secondary w-100">Restablecer</a>
    </div>
</form>

<table class="table table-striped table-bordered shadow-sm align-middle rounded">
    <thead class="table-success text-center">
        <tr>
            <th>Cédula</th>
            <th>Nombre</th>
            <th>Primer Apellido</th>
            <th>Segundo Apellido</th>
            <th>Fecha Nacimiento</th>
            <th>Fecha Creación</th>
            <th>Activo</th>
            <th>Correos</th>
            <th>Teléfonos</th>
            <th>Género</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="text-center">@item.IdCedula</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido1</td>
                <td>@item.Apellido2</td>
                <td>@item.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                <td>@item.FechaCreacion?.ToString("dd/MM/yyyy HH:mm")</td>

                <td class="text-center">
                    @if (item.Activo == true)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>

                <td>
                    @if (item.Correos != null && item.Correos.Any())
                    {
                        @foreach (var correo in item.Correos)
                        {
                            <div>@correo.DirecCorreo</div>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>

                <td>
                    @if (item.Telefonos != null && item.Telefonos.Any())
                    {
                        @foreach (var tel in item.Telefonos)
                        {
                            <div>@tel.Numero</div>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>

                <td class="text-center">
                    @(item.IdGeneroNavigation?.Descripcion ?? "Sin género")
                </td>

                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.IdCedula" class="btn btn-primary btn-sm me-1">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.IdCedula" class="btn btn-info btn-sm me-1">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.IdCedula" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
