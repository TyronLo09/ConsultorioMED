@model ConsultorioMedAPP.Models.Persona

@{
    ViewData["Title"] = "Eliminar Persona";
}

<div class="container mt-4">
    <h2 class="text-danger mb-3">Eliminar Persona</h2>
    <p class="text-muted">¿Estás seguro de que deseas eliminar esta persona del registro?</p>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 fw-bold">Nombre</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

                <dt class="col-sm-3 fw-bold">Primer Apellido</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Apellido1)</dd>

                <dt class="col-sm-3 fw-bold">Segundo Apellido</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Apellido2)</dd>

                <dt class="col-sm-3 fw-bold">Fecha de Nacimiento</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FechaNacimiento)</dd>

                <dt class="col-sm-3 fw-bold">Fecha de Creación</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FechaCreacion)</dd>

                <dt class="col-sm-3 fw-bold">Estado</dt>
                <dd class="col-sm-9">
                    @(Model.Activo == true ? "Activo" : "Inactivo")
                </dd>

                <dt class="col-sm-3 fw-bold">Género</dt>
                <dd class="col-sm-9">
                    @(Model.IdGeneroNavigation?.Descripcion ?? "Sin género")
                </dd>

                

               
            </dl>
        </div>
    </div>

    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="IdCedula" />
        <button type="submit" class="btn btn-danger px-4 me-2">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
    </form>
</div>
