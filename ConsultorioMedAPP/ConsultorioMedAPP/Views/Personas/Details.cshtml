@model ConsultorioMedAPP.Models.Persona

@{
    ViewData["Title"] = "Detalles de Persona";
}

<h1>Detalles</h1>

<div class="card mb-3">
    <div class="card-header">
        <strong>Cédula:</strong> @ViewBag.FormattedCedula
    </div>
    <div class="card-body">
        <p><strong>Nombre:</strong> @Model.Nombre @Model.Apellido1 @Model.Apellido2</p>
        <p><strong>Fecha nacimiento:</strong> @Model.FechaNacimiento.ToString("dd/MM/yyyy")</p>
        <p><strong>Género:</strong> @(Model.IdGeneroNavigation?.Descripcion ?? "Sin género")</p>
        <p><strong>Activo:</strong> @(Model.Activo == true ? "Sí" : "No")</p>

        <hr />

        <h5>Correos</h5>
        @if (Model.Correos != null && Model.Correos.Any())
        {
            <ul>
                @foreach (var c in Model.Correos)
                {
                    <li>@c.DirecCorreo (@c.IdTipoCorreoNavigation?.Descripcion)</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">—</p>
        }

        <h5>Teléfonos</h5>
        @if (Model.Telefonos != null && Model.Telefonos.Any())
        {
            <ul>
                @foreach (var t in Model.Telefonos)
                {
                    <li>@t.Numero (@t.IdTipoTelefonoNavigation?.Descripcion)</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">—</p>
        }
    </div>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.IdCedula" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</p>
