@{
    ViewData["Title"] = "Página No Encontrada";
    Layout = "_LayoutLogin";
}

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="row justify-content-center w-100">
        <div class="col-md-6 col-lg-5 text-center">
            <div class="mb-4">
                <div class="display-1 text-muted mb-3">404</div>
                <i class="fas fa-search fa-5x text-primary mb-4"></i>
            </div>

            <h1 class="h2 text-dark mb-3">Página No Encontrada</h1>
            <p class="text-muted mb-4">
                Lo sentimos, la página que estás buscando no existe o ha sido movida.
            </p>

            <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4">
                    <i class="fas fa-home me-2"></i>Volver al Inicio
                </a>
            </div>

            <div class="mt-5">
                <small class="text-muted">
                    Si crees que esto es un error, contacta al administrador del sistema.
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>
}