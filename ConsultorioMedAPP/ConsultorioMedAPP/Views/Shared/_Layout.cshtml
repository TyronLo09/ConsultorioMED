<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ConsultorioMedAPP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ConsultorioMedAPP.styles.css" asp-append-version="true" />

    <style>
        body {
            display: flex;
            min-height: 100vh;
            background-color: #f5f7fa;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Sidebar (mismo color que el botón Crear Nueva Persona) */
        .sidebar {
            width: 250px;
            background-color: #198754; /* color igual al botón */
            padding-top: 0;
            position: fixed;
            height: 100%;
            box-shadow: 3px 0 15px rgba(0, 0, 0, 0.1);
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .sidebar-header {
            background-color: rgba(255, 255, 255, 0.15);
            padding: 15px 10px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar-brand {
            font-weight: 700;
            color: #004aad !important; /* azul */
            font-size: 1.3rem;
            text-decoration: none;
            margin: 0;
        }

            .navbar-brand:hover {
                color: #002f6c !important; /* azul más oscuro al pasar el mouse */
            }

        /* Logo */
        .logo-img {
            width: 50px;
            height: auto;
            border-radius: 10px;
            background-color: white;
            padding: 3px;
        }

        .sidebar-menu {
            padding: 15px 0;
            flex-grow: 1;
        }

        /* Enlaces del menú lateral */
        .sidebar a {
            display: flex;
            align-items: center;
            color: #004aad; /* texto azul */
            padding: 12px 20px;
            text-decoration: none;
            transition: all 0.3s;
            font-size: 0.95rem;
            border-left: 3px solid transparent;
            font-weight: 600;
        }

            .sidebar a:hover {
                background-color: rgba(255, 255, 255, 0.3);
                border-left-color: #004aad; /* azul al pasar */
                padding-left: 25px;
                color: #002f6c; /* azul más oscuro */
            }

            .sidebar a.menu-category {
                font-weight: 700;
            }

        .sidebar .submenu {
            background-color: rgba(255, 255, 255, 0.2);
            padding-left: 0;
        }

            .sidebar .submenu a {
                padding-left: 45px;
                font-size: 0.9rem;
                font-weight: 500;
                color: #004aad; /* también azul */
            }

                .sidebar .submenu a:hover {
                    padding-left: 50px;
                    color: #002f6c;
                }

        .menu-icon {
            margin-right: 12px;
            font-size: 1.1rem;
            width: 24px;
            text-align: center;
        }

        /* Contenido principal */
        .main-content {
            margin-left: 250px;
            padding: 30px;
            width: 100%;
            background-color: #f5f7fa;
        }

        footer {
            background: #fff;
            padding: 20px;
            text-align: center;
            border-top: 1px solid #e0e0e0;
            color: #666;
            margin-top: 40px;
        }

        /* Scrollbar */
        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 3px;
        }

        hr {
            border-color: rgba(255, 255, 255, 0.4);
            margin: 10px 20px;
        }

        /* Botón de cerrar sesión */
        .logout-section {
            padding: 20px;
            margin-top: auto;
            border-top: 1px solid rgba(255, 255, 255, 0.3);
        }

        .btn-logout {
            width: 100%;
            background: linear-gradient(135deg, #dc3545, #c82333);
            border: none;
            color: white;
            padding: 12px 20px;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
            text-align: center;
        }

            .btn-logout:hover {
                background: linear-gradient(135deg, #c82333, #a71e2a);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
            }

            .btn-logout:active {
                transform: translateY(0);
            }

        .logout-icon {
            font-size: 1.1rem;
        }
    </style>

</head>

<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                DUNAMYS S.A.
            </a>
            <img src="~/logo.png" alt="Logo" class="logo-img" />
        </div>

        <div class="sidebar-menu">
            <a asp-controller="Home" asp-action="Index">
                <span class="menu-icon">🏠</span> Inicio
            </a>

            <a class="menu-category" data-bs-toggle="collapse" href="#menuPersonas">
                <span class="menu-icon">👤</span> Personal
            </a>
            <div class="collapse submenu" id="menuPersonas">
                <a asp-controller="Personas" asp-action="Index">Personas</a>
                <a asp-controller="Generoes" asp-action="Index">Géneros</a>
                <a asp-controller="Correos" asp-action="Index">Correos</a>
                <a asp-controller="TipoCorreos" asp-action="Index">Tipo de Correos</a>
                <a asp-controller="Telefonoes" asp-action="Index">Teléfonos</a>
                <a asp-controller="TipoTelefonoes" asp-action="Index">Tipo de Teléfonos</a>
            </div>

            <a class="menu-category" data-bs-toggle="collapse" href="#menuPacientes">
                <span class="menu-icon">🩺</span> Clientes
            </a>
            <div class="collapse submenu" id="menuPacientes">
                <a asp-controller="Pacientes" asp-action="Index">Pacientes</a>
                <a asp-controller="Seguroes" asp-action="Index">Seguro</a>
                <a asp-controller="TipoSeguroes" asp-action="Index">Tipo de Seguro</a>
                <a asp-controller="TipoEnfermedads" asp-action="Index">Tipo de Enfermedad</a>
                <a asp-controller="AntecedentesMedicoes" asp-action="Index">Antecedentes Médicos</a>
            </div>

            <a class="menu-category" data-bs-toggle="collapse" href="#menuDoctores">
                <span class="menu-icon">👨‍⚕️</span> Doctores
            </a>
            <div class="collapse submenu" id="menuDoctores">
                <a asp-controller="Doctors" asp-action="Index">Doctores</a>
                <a asp-controller="Especialidads" asp-action="Index">Especialidades</a>
                <a asp-controller="Diagnosticoes" asp-action="Index">Diagnóstico</a>
                <a asp-controller="Turnoes" asp-action="Index">Turno</a>
                <a asp-controller="TipoTurnoes" asp-action="Index">Tipo de Turnos</a>
            </div>

            <a class="menu-category" data-bs-toggle="collapse" href="#menuCitas">
                <span class="menu-icon">📅</span> Citas
            </a>
            <div class="collapse submenu" id="menuCitas">
                <a asp-controller="Citums" asp-action="Index">Gestión de Citas</a>
                <a asp-controller="EstadoCitums" asp-action="Index">Estado de la Cita</a>
            </div>

            <a class="menu-category" data-bs-toggle="collapse" href="#menuFactura">
                <span class="menu-icon">💰</span> Finanzas
            </a>
            <div class="collapse submenu" id="menuFactura">
                <a asp-controller="Facturas" asp-action="Index">Facturas</a>
                <a asp-controller="DetalleFacturas" asp-action="Index">Detalle de Facturas</a>
            </div>

            <a class="menu-category" data-bs-toggle="collapse" href="#menuUsuarios">
                <span class="menu-icon">👥</span> Usuarios
            </a>
            <div class="collapse submenu" id="menuUsuarios">
                <a asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                <a asp-controller="RolUsuarios" asp-action="Index">Rol Usuarios</a>
            </div>

            <hr />

            <a asp-controller="Home" asp-action="Privacy">
                <span class="menu-icon">📊</span> Inventario
            </a>

            <a asp-controller="Home" asp-action="Privacy">
                <span class="menu-icon">🔒</span> Privacidad
            </a>
        </div>

        <!-- Sección de Cerrar Sesión -->
        <div class="logout-section">
            <a asp-controller="Login" asp-action="Logout" class="btn-logout">
                <span class="logout-icon">🚪</span>
                Cerrar Sesión
            </a>
        </div>
    </div>

    <!-- Contenido principal -->
    <div class="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        <footer class="border-top footer text-muted"></footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>