@model ConsultorioMedAPP.Models.TipoEnfermedad

@{
    ViewData["Title"] = "Eliminar Tipo de Enfermedad"; // Título traducido
}

<h1>Eliminar</h1>

<h3>¿Estás seguro de que quieres eliminar este Tipo de Enfermedad?</h3>
<div>
    <h4>Tipo de Enfermedad</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Descripcion)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Activo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Activo)</dd>

    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdTipoEnfermedad" />

        <input type="submit" value="Eliminar" class="btn btn-danger" />
        |
        <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
    </form>
</div>