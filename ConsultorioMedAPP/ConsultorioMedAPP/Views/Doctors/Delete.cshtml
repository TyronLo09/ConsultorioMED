@model ConsultorioMedAPP.Models.Doctor

@{
    ViewData["Title"] = "Eliminar Doctor";
}

<div class="card shadow-lg border-0 rounded-4 mt-4">
    <div class="card-header text-white text-center" style="background-color: #20c997;">
        <h3 class="mb-0">Eliminar Doctor</h3>
    </div>

    <div class="card-body">

        <!-- Bloque de confirmación visual -->
        <div class="alert alert-warning text-center rounded-3 shadow-sm py-3 mb-4">
            <i class="bi bi-exclamation-triangle-fill text-warning fs-3"></i>
            <h5 class="fw-bold mt-2">¿Estás completamente seguro de eliminar este doctor?</h5>
            <p class="text-muted mb-0">Esta acción no se puede deshacer y eliminará permanentemente el registro del sistema.</p>
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-3 fw-semibold text-end">Estado:</dt>
            <dd class="col-sm-9">
                @if (Model.Activo == true)
                {
                    <span class="badge bg-success px-3 py-2 shadow-sm">Activo</span>
                }
                else if (Model.Activo == false)
                {
                    <span class="badge bg-danger px-3 py-2 shadow-sm">Inactivo</span>
                }
                else
                {
                    <span class="badge bg-secondary px-3 py-2 shadow-sm">No especificado</span>
                }
            </dd>

            <dt class="col-sm-3 fw-semibold text-end">Cédula:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.IdCedulaNavigation.IdCedula)</dd>

            <dt class="col-sm-3 fw-semibold text-end">Especialidad:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.IdEspecialidadNavigation.Descripcion)</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="IdCedula" />

            <div class="d-flex justify-content-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-2 rounded-3 px-4">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-danger rounded-3 px-4">
                    <i class="bi bi-trash"></i> Sí, eliminar
                </button>
            </div>
        </form>
    </div>
</div>
