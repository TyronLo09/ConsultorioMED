@model IEnumerable<ConsultorioMedAPP.Models.Doctor>

@{
    ViewData["Title"] = "Lista de Doctores";
}

<div class="card shadow-lg border-0 rounded-4 mt-4">
    <div class="card-header text-white text-center" style="background-color: #20c997;">
        <h3 class="mb-0">Lista de Doctores</h3>
    </div>

    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="mb-0 text-muted">Gestione aquí los doctores registrados en el sistema.</p>
            <a asp-action="Create" class="btn btn-success rounded-3 shadow-sm">
                <i class="bi bi-plus-circle"></i> Crear Nuevo Doctor
            </a>
        </div>

        <table class="table table-hover align-middle text-center shadow-sm rounded-3">
            <thead class="text-white" style="background-color: #20c997;">
                <tr>
                    <th>Nombre</th>
                    <th>Primer Apellido</th>
                    <th>Segundo Apellido</th>
                    <th>Especialidad</th>
                    <th>Activo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdCedulaNavigation.Nombre</td>
                        <td>@item.IdCedulaNavigation.Apellido1</td>
                        <td>@item.IdCedulaNavigation.Apellido2</td>
                        <td>@item.IdEspecialidadNavigation.Descripcion</td>
                        <td>
                            @if (item.Activo == true)
                            {
                                <span class="badge bg-success px-3 py-2 shadow-sm">Activo</span>
                            }
                            else if (item.Activo == false)
                            {
                                <span class="badge bg-danger px-3 py-2 shadow-sm">Inactivo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2 shadow-sm">No especificado</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.IdCedula" class="btn btn-primary btn-sm rounded-3 shadow-sm">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <a asp-action="Details" asp-route-id="@item.IdCedula" class="btn btn-info btn-sm rounded-3 shadow-sm text-white">
                                    <i class="bi bi-eye"></i> Detalles
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.IdCedula" class="btn btn-danger btn-sm rounded-3 shadow-sm">
                                    <i class="bi bi-trash"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
