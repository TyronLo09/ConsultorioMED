@model ConsultorioMedAPP.Models.Doctor

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">
        @ViewData["Error"]
    </div>
}
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">
        @TempData["MensajeExito"]
    </div>
}


@{
    ViewData["Title"] = "Registrar Doctor";
}

<h2 class="text-center mb-4">Registrar nuevo doctor</h2>

<div class="container mt-4">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-md-6">
                <label asp-for="IdCedula" class="form-label">Cédula y nombre</label>
                <select asp-for="IdCedula" class="form-select" asp-items="ViewBag.IdCedula" required>
                    <option value="">Seleccione una persona</option>
                </select>
                <span asp-validation-for="IdCedula" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="IdEspecialidad" class="form-label">Especialidad</label>
                <select asp-for="IdEspecialidad" class="form-select" asp-items="ViewBag.IdEspecialidad" required>
                    <option value="">Seleccione una especialidad</option>
                </select>
                <span asp-validation-for="IdEspecialidad" class="text-danger"></span>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-3">
                <div class="form-check form-switch">
                    <!-- ✅ Campo visible -->
                    <input type="checkbox" id="Activo" name="Activo" class="form-check-input" value="true" />
                    <label class="form-check-label" for="Activo">Activo</label>

                    <!-- ✅ Campo oculto para enviar false cuando no se marca -->
                    <input type="hidden" name="Activo" value="false" />
                </div>
            </div>
        </div>

        <div class="mt-4">
            <input type="submit" value="Guardar" class="btn btn-success" />
            <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
