@model ConsultorioMedAPP.Models.Turno

@{
    ViewData["Title"] = "Editar Turno";
}

<div class="card shadow-lg border-0 rounded-4 mt-4">
    <div class="card-header bg-gradient bg-primary text-white text-center py-3">
        <h3 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Editar Turno</h3>
    </div>

    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="IdTurno" />

            <div class="mb-3">
                <label asp-for="IdCedula" class="form-label fw-semibold">Doctor</label>
                <select asp-for="IdCedula" class="form-select rounded-3 shadow-sm" asp-items="ViewBag.IdCedula">
                    <option value="">Seleccione Doctor</option>
                </select>
                <span asp-validation-for="IdCedula" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IdTipoTurno" class="form-label fw-semibold">Tipo de Turno</label>
                <select asp-for="IdTipoTurno" class="form-select rounded-3 shadow-sm" asp-items="ViewBag.IdTipoTurno">
                    <option value="">Seleccione Tipo de Turno</option>
                </select>
                <span asp-validation-for="IdTipoTurno" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Activo" class="form-label fw-semibold">Estado</label>
                <select asp-for="Activo" class="form-select rounded-3 shadow-sm">
                    <option value="">Seleccione estado</option>
                    <option value="true">Activo</option>
                    <option value="false">Inactivo</option>
                </select>
                <span asp-validation-for="Activo" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-2 rounded-3 px-4">
                    <i class="bi bi-arrow-left-circle"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-primary rounded-3 px-4">
                    <i class="bi bi-save"></i> Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
