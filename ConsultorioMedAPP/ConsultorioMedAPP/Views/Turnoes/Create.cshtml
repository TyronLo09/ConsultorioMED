@model ConsultorioMedAPP.Models.Turno

@{
    ViewData["Title"] = "Crear Turno";
}

<div class="card shadow-lg border-0 rounded-4 mt-4">
    <div class="card-header text-white text-center" style="background-color: #20c997;">
        <h3 class="mb-0">Crear Nuevo Turno</h3>
    </div>

    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="IdCedula" class="form-label fw-semibold">Doctor</label>
                <select asp-for="IdCedula" class="form-select rounded-3 shadow-sm" asp-items="ViewBag.IdCedula">
                    <option value="">Seleccione un doctor</option>
                </select>
                <span asp-validation-for="IdCedula" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IdTipoTurno" class="form-label fw-semibold">Tipo de Turno</label>
                <select asp-for="IdTipoTurno" class="form-select rounded-3 shadow-sm" asp-items="ViewBag.IdTipoTurno">
                    <option value="">Seleccione un tipo de turno</option>
                </select>
                <span asp-validation-for="IdTipoTurno" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-2 rounded-3 px-4">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-primary rounded-3 px-4">
                    <i class="bi bi-plus-circle"></i> Crear Turno
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
