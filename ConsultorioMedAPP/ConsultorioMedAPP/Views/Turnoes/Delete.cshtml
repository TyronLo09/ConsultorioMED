@model ConsultorioMedAPP.Models.Turno

@{
    ViewData["Title"] = "Eliminar Turno";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient bg-danger text-white text-center py-3">
            <h3 class="mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar eliminación
            </h3>
        </div>

        <div class="card-body">
            <p class="text-center fs-5 mb-4">
                ¿Estás seguro de que deseas eliminar este turno? <br />
                <strong class="text-danger">Esta acción no se puede deshacer.</strong>
            </p>

            <div class="border rounded-4 p-4 bg-light shadow-sm">
                <dl class="row g-3 mb-0">

                    <dt class="col-sm-3 fw-bold text-secondary">Doctor:</dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.IdCedulaNavigation.IdCedulaNavigation.Nombre)
                        @Html.DisplayFor(model => model.IdCedulaNavigation.IdCedulaNavigation.Apellido1)
                        @Html.DisplayFor(model => model.IdCedulaNavigation.IdCedulaNavigation.Apellido2)
                    </dd>

                    <dt class="col-sm-3 fw-bold text-secondary">Tipo de turno:</dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.IdTipoTurnoNavigation.Descripcion)
                    </dd>

                    <dt class="col-sm-3 fw-bold text-secondary">Estado:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Activo.HasValue && Model.Activo.Value)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </dd>

                </dl>
            </div>
        </div>

        <div class="card-footer text-center">
            <form asp-action="Delete" class="d-inline">
                <input type="hidden" asp-for="IdTurno" />
                <button type="submit" class="btn btn-danger px-4 me-2">
                    <i class="bi bi-trash"></i> Eliminar definitivamente
                </button>
            </form>
            <a asp-action="Index" class="btn btn-secondary px-4">
                <i class="bi bi-arrow-left-circle"></i> Cancelar
            </a>
        </div>
    </div>
</div>
