@model ConsultorioMedAPP.Models.Turno

@{
    ViewData["Title"] = "Detalles del Turno";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient bg-info text-white text-center py-3">
            <h3 class="mb-0">
                <i class="bi bi-info-circle-fill me-2"></i> Detalles del Turno
            </h3>
        </div>

        <div class="card-body">
            <dl class="row g-3 mb-0">

                <dt class="col-sm-3 fw-bold text-secondary">Doctor:</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.IdCedulaNavigation.IdCedulaNavigation.Nombre)
                    @Html.DisplayFor(model => model.IdCedulaNavigation.IdCedulaNavigation.Apellido1)
                    @Html.DisplayFor(model => model.IdCedulaNavigation.IdCedulaNavigation.Apellido2)
                </dd>

                <dt class="col-sm-3 fw-bold text-secondary">Tipo de turno:</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.IdTipoTurnoNavigation.Descripcion)
                </dd>

                <dt class="col-sm-3 fw-bold text-secondary">Estado:</dt>
                <dd class="col-sm-9">
                    @if (Model.Activo.HasValue && Model.Activo.Value)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </dd>

            </dl>
        </div>

        <div class="card-footer text-center">
            <a asp-action="Edit" asp-route-id="@Model?.IdTurno" class="btn btn-primary px-4 me-2">
                <i class="bi bi-pencil-square"></i> Editar
            </a>
            <a asp-action="Index" class="btn btn-secondary px-4">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>
        </div>
    </div>
</div>
